}*/

test "con inmunidad no se pierde vida" {
  gatito.calcularFelicidad(10)
  gatito.perderVida()
  assert.equals(3, gatito.vidas())
}

test "el gatito al interactuar con un hueso lo guarda en su inventario"{
    huesoUno.interactuarCon(gatito)
    assert.that(gatito.tieneItem(huesoUno))
  }
  test "Al interactuar con el perro pierde una vida y vuelve al inicio" {
    //El gatito arranca con 3 vidas por defecto
    perro.interactuarCon(gatito)
    assert.equals(2, gatito.vidas())
    assert.equals(game.at(7,1), gatito.position()) 
  }

  test "Si el gatito choca con el perro la cantidad de sus vidas, queda en 0 (Derrota)" {
    gatito.vidas(3) // Aseguramos que arranque con 3 vidas
    
    // Repite la colisión 3 veces
    3.times({ i => perro.interactuarCon(gatito) })
    
    assert.equals(0, gatito.vidas())
  }

  test "Al interactuar con la llave, la llave se guarda en el inventario" {
    const llaveDePrueba = new Llave(position = game.at(1,1))
    llaveDePrueba.interactuarCon(gatito)
    assert.that(gatito.tieneItem(llaveDePrueba)) 
  }

  test "Si choca con la puerta SIN tener la llave, el gatito no gana el juego" {
    assert.notThat(gatito.tieneItem(unaLlave)) 
    puerta.interactuarCon(gatito)
    assert.equals(3, gatito.vidas())
  }

  test "Si choca con una Hitbox de la puerta SIN llave, no pasa nada" {
    const hitbox = new HitboxPuerta(position = game.at(6, 11))
    hitbox.interactuarCon(gatito)
    assert.notThat(gatito.tieneItem(unaLlave))
  }
}

describe "Persecucion y orientacion del perro"{
  test "el perro de mueve hacia arriba si esta abajo del gato"{
        gatito.position(game.at(7,7))
        const perroNuevo = new Perro (position = game.at(7,5))

        perroNuevo.perseguir(gatito)

        assert.equals(game.at(7,6), perroNuevo.position())
    }
  test "el perro se mueve hacia la derecha"{
    gatito.position(game.at(7,7))
        const perroNuevo = new Perro (position = game.at(5,7))

        perroNuevo.perseguir(gatito)

        assert.equals(game.at(6,7), perroNuevo.position())
  }

  test "el perro pude cambiar su orientacion"{
        const perroNuevo = new Perro (position = game.at(7,5)) 

      perroNuevo.mirarHacia("derecha")
      assert.equals("derecha", perroNuevo.orientacion())
    }
}

describe "Mecanica llave"{
  
  test "al darle el hueso al perro no pierde vida, suelta el hueso y el perro lo recibe"{
    gatito.agarrarItem(huesoUno)
    perro.interactuarCon(gatito)
    assert.equals(3, gatito.vidas())
    assert.notThat(gatito.tieneItem(huesoUno))
    assert.that(perro.recibioHueso())
  }

  test "si el gatito es inmune, le saca la llave a la dueña sin perder vidas"{
    gatito.activarInmunidad()
    dueña.interactuarCon(gatito)
    assert.equals(3, gatito.vidas())
    assert.that(gatito.tieneItem(unaLlave))
    assert.notThat(dueña.tieneLlave())
  }
  
  test "puerta del nivel dos con la llave de la dueña termina el juego sin perder vidas"{
    gatito.activarInmunidad()
    dueña.interactuarCon(gatito)
    puertaDos.interactuarCon(gatito)
    assert.equals(3, gatito.vidas())
  }
}

describe "usos de items e inventario"{
  test "si el item es util encuentra un objeto compatible y devuelve null si nunguno sirve"{
    const huesoPrueba = new Hueso(position = game.at(1,2))
    const perroPrueba = new Perro(position = game.at(1,3))

    const puertaNueva = puerta

    gatito.agarrarItem(huesoPrueba)

    //elhueso le sirve al perro pero no para la puerta
    assert.equals(huesoPrueba, gatito.itemUtilPara(perroPrueba))
    assert.equals(null, gatito.itemUtilPara(puertaNueva))

  }

  test "si no hay items en el inventario devuelve null"{
    const perroPrueba = new Perro (position = game.at(3,4))
    assert.equals(null, gatito.itemUtilPara(perroPrueba))
  }

  test "llave sirve para las puertas pero no para el perro"{
    const llavePrueba = new Llave (position = game.at(2,6))
    const perroPrueba = new Perro (position = game.at(4,3))

    assert.that(llavePrueba.sirvePara(puerta))
    assert.that(llavePrueba.sirvePara(puertaDos))
    assert.notThat(llavePrueba.sirvePara(perroPrueba))
  }

}

describe "Estados del gatito" {

  test "En estado normal puede moverse y muestra su imagen normal" {
    assert.that(gatito.puedeMoverse())
    assert.equals("gatitofrente.png", gatito.image())
  }

  test "Cuando juega no puede moverse y cambia su imagen segun el juguete" {
    const ovillo = new Ovillo(position = game.at(0, 0))
    gatito.jugar(ovillo)
    
    assert.notThat(gatito.puedeMoverse())
    assert.equals("jugandoconovillo.png", gatito.image())
  }

  test "Cuando se moja no puede moverse, cambia su imagen y sigue perdiendo vida" {
    gatito.mojarse()
    assert.notThat(gatito.puedeMoverse())
    assert.equals("gatoMojado.png", gatito.image())
    gatito.perderVida()
    assert.equals(2, gatito.vidas())
  }

  test "Cuando esta inmune puede moverse, cambia su imagen y no pierde vida" {
    gatito.activarInmunidad()
    assert.that(gatito.puedeMoverse())
    assert.equals("gatitofelizfrente.png", gatito.image())
    gatito.perderVida()
    assert.equals(3, gatito.vidas())
  }

  test "Cuando llega a 0 vidas pasa a derrotado, no se mueve y no sigue perdiendo vidas" {
    gatito.vidas(1)
    gatito.perderVida()
    assert.equals(0, gatito.vidas())
    assert.notThat(gatito.puedeMoverse())
    assert.equals("gatitoDerrotado.png", gatito.image())
    gatito.perderVida()
    assert.equals(0, gatito.vidas())//si pierde mas vidas no baja a negativo
  }
}
