import gatitos.*
import obstaculos.*
import movimientos.*
describe "Estado inicial del gatito, y limites de energia y felicidad"{
  test "posicion inicial del gatito"{
    assert.equals(game.at(7,1), gatito.position())
  }

  test "El gatito arranca sin la llave" {
    assert.notThat(gatito.tieneLlave()) 
  }
  
  test "el gatito arranca con energia 100 y felicidad 0" {
    assert.equals(100, gatito.energia())
    assert.equals(0, gatito.felicidad())
  }

  test"La energia siempre esta entre 0 y 100"{
    gatito.calcularEnergia(-150)
    assert.equals(0, gatito.energia())
    gatito.calcularEnergia(200)
    assert.equals(100, gatito.energia())
  }

  test "La felicidad siempre esta entre 0 y 10"{
    gatito.calcularFelicidad(-15)
    assert.equals(0, gatito.felicidad())
    gatito.calcularFelicidad(20)
    assert.equals(10, gatito.felicidad())
  }
}

describe "Limites del mapa"{  
  test "El gatito no puede salirse del mapa por arriba" {
    //Parado en el limite superior
    gatito.position(game.at(5, 11)) 
    movimiento.mover(gatito, haciaArriba)
    assert.equals(game.at(5, 11), gatito.position()) //Comparamos si se mantuvo en la misma posicion
  }

  test "El gatito no puede salirse del mapa por abajo" {
    //Parado en el limite inferior
    gatito.position(game.at(5, 1)) 
    movimiento.mover(gatito, haciaAbajo)
    assert.equals(game.at(5, 1), gatito.position()) //Comparamos si se mantuvo en la misma posicion
  }

  test "El gatito no puede salirse del mapa por la izquierda" {
    //Parado en el limite izquierdo
    gatito.position(game.at(1, 5))
    movimiento.mover(gatito, haciaLaIzquierda)
    assert.equals(game.at(1, 5), gatito.position())
  }

  test "El gatito no puede salirse del mapa por la derecha" {
    //Parado en el limite derecho
    gatito.position(game.at(13, 5))
    movimiento.mover(gatito, haciaLaDerecha)
    assert.equals(game.at(13, 5), gatito.position())
  }

}

describe "Interacciones del gatito"{//gatito por defecto energia 100 y felicidad 0
  test "Al interactuar con el ovillo se sube la felicidad y baja la energia"{
    gatito.calcularEnergia(-50) //Baja 50 de energia (queda en 50) y felicidad por defecto en 0
    const ovilloDePrueba = new Ovillo(position = game.at(0, 0))
    ovilloDePrueba.interactuarCon(gatito)//Baja 25 de energia (queda en 25), suma 2 de felicidad (queda en 2)
    assert.equals(25, gatito.energia())
    assert.equals(2, gatito.felicidad())
  }

  test "Al interactuar con el plato de comida, sube la energia y felicidad del gatito" {
    // Preparación
    gatito.calcularEnergia(-50) 
    const unPlato = new PlatoDeComida(position = game.at(0,0))
    unPlato.interactuarCon(gatito)
    assert.equals(80, gatito.energia()) // 50 + 30 del plato
    assert.equals(3, gatito.felicidad())
  }

  test "Al interactuar con patio de juego, juega dos veces"{
    patioDeJuego.interactuarCon(gatito)//gatito juega dos veces(-25 de energia y +2 de felciadd por juego) 
    assert.equals(50, gatito.energia())
    assert.equals(4, gatito.felicidad())
  }

  test "Comer aumenta la energia y la felicidad" {
    gatito.jugar("ovillo") //Baja 25 de energía (queda en 75), suma 2 de felicidad
    gatito.jugar("patio") //Baja otros 25 (queda en 50), suma 2 más (felicidad 4)
    gatito.comer() //Suma 30 de energía y 3 de felicidad
    assert.equals(80, gatito.energia())
    assert.equals(7, gatito.felicidad())
  }

  test "energia en 0 resta una vida y repone energia" {
  gatito.calcularEnergia(-100)
  assert.equals(2, gatito.vidas())
}

 test "felicidad al llegar a 10 vuelve al gatito inmune" {
  gatito.calcularFelicidad(10)
  assert.that(gatito.inmune())
}

test "con inmunidad no se pierde vida" {
  gatito.calcularFelicidad(10)
  gatito.perderVida()
  assert.equals(3, gatito.vidas())
}


  test "Al interactuar con el perro pierde una vida y vuelve al inicio" {
    //El gatito arranca con 3 vidas por defecto
    perro.interactuarCon(gatito)
    assert.equals(2, gatito.vidas())
    assert.equals(game.at(7,1), gatito.position()) 
  }

  test "Si el gatito choca con el perro la cantidad de sus vidas, queda en 0 (Derrota)" {
    gatito.vidas(3) // Aseguramos que arranque con 3 vidas
    
    // Repite la colisión 3 veces
    3.times({ i => perro.interactuarCon(gatito) })
    
    assert.equals(0, gatito.vidas())
  }

  test "Al interactuar con la llave, el gatito cambia su estado a tieneLlave" {
    const llaveDePrueba = new Llave(position = game.at(1,1))
    llaveDePrueba.interactuarCon(gatito)
    assert.that(gatito.tieneLlave()) 
  }

  test "Si choca con la puerta SIN tener la llave, el gatito no gana el juego" {
    assert.notThat(gatito.tieneLlave()) 
    puerta.interactuarCon(gatito)
    assert.equals(3, gatito.vidas())
  }

  test "Si choca con una Hitbox de la puerta SIN llave, no pasa nada" {
    const hitbox = new HitboxPuerta(position = game.at(6, 11))
    hitbox.interactuarCon(gatito)
    assert.notThat(gatito.tieneLlave())
  }
}